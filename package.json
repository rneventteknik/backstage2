        "objection": "^4.3.0",
        "pg": "^8.20.0",
        "posthog-js": "^1.367.0",
        "react": "^19.3.1",
        "react-bootstrap": "^2.10.10",
        "react-bootstrap-typeahead": "^6.4.1",
        "react-bus": "^4.0.1",
        "react-dom": "^19.3.1",
        "react-dropzone": "^20.1.4",
        "react-highlight-words": "^1.0.0",
        "react-loading-skeleton": "^3.5.0",
        "react-markdown": "^10.1.0",
