{
    "name": "backstage2",
    "version": "1.26.1-lingonberry",
    "type": "module",
    "engines": {
        "node": "^26.0.0"
    },
    "scripts": {
        "dev": "next",
        "build": "next build",
        "start": "next start",
        "tc": "tsc",
        "lint": "eslint .",
        "format": "prettier -w .",
        "format:check": "prettier -c .",
        "tcl": "tsc && eslint .",
        "migrate": "knex migrate:latest",
        "migrate:down": "knex migrate:down",
        "migrate:make": "knex migrate:make --stub knex/migrations_stub.js",
        "seed": "knex seed:run --specific=mock.js",
        "seed:init": "knex seed:run --specific=init.js",
        "test": "cypress run -q",
        "reset-sqlite": "rimraf dev.sqlite3 && npm run migrate && npm run seed"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
