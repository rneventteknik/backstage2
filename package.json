        "@fortawesome/react-fontawesome": "^3.3.0",
        "@googleapis/calendar": "^20.1.0",
        "@googleapis/drive": "^27.0.0",
        "@react-pdf/renderer": "^4.4.0",
        "@slack/web-api": "^8.2.0",
        "archiver": "^8.0.0",
        "bcryptjs": "^3.0.3",
        "better-sqlite3": "^13.0.3",
